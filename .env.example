# Aurea Solaris — Environment variables
# Copy this file to .env and fill in the real values.
# Never commit secrets to the repository.

# Core local runtime
AUREA_DATA_DIR=
AUREA_SIDECAR_TOKEN=
AUREA_SESSION_SECRET=

# Optional AI/provider integrations (selected explicitly per conversation)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional local model endpoint (Ollama, etc.)
LOCAL_MODEL_URL=http://127.0.0.1:11434

# Development / release paths
CARGO_TARGET_DIR=work/cargo-target-dev
