# Aurea Solaris Private Web V1 — example environment values
# Copy only the variables needed by your local workflow.
# Never commit real secrets or production credentials.

# Browser-visible Web V1 configuration. VITE_* values are public by definition.
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUREA_API_URL=http://127.0.0.1:8000

# Server-side Web API configuration (services/api).
AUREA_ENVIRONMENT=development
AUREA_SUPABASE_URL=https://example.supabase.co
AUREA_JWT_AUDIENCE=authenticated
# Secret: intentionally blank in the committed example. Supply only through ignored/provider-managed env.
AUREA_DATABASE_URL=
AUREA_ALLOWED_ORIGINS=http://localhost:5173
AUREA_EPHEMERIS_PATH=./services/api/ephe
