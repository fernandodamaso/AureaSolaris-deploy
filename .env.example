# Aurea Solaris — Environment variables
# Copy this file to .env and fill in the real values.
# Never commit secrets to the repository.

# Astro/LLM
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=

# Integrations
TODOIST_TOKEN=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
COMPOSIO_API_KEY=

# Hermes gateway (optional local default)
HERMES_GATEWAY_URL=http://localhost:20128/v1/chat/completions
HERMES_MODEL=hermes-combo
